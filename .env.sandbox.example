# Railway overrides for temporary pre-launch Sandbox testing on the existing service.
# Merge these into Railway Variables; retain existing secrets and storage/database settings.
# Do not use on a service with live paying customers.
STAYZY_ENVIRONMENT=staging
STAYZY_APPLE_ENVIRONMENT=Sandbox
STAYZY_APPLE_TEAM_ID=7ATG4J8L4X
STAYZY_APPLE_BUNDLE_ID=com.vistasolutions.stayzy
STAYZY_APPLE_APP_ID=6808848074
STAYZY_LIFETIME_PRODUCT_ID=com.vistasolutions.stayzy.premium.lifetime
STAYZY_PUBLIC_APP_URL=https://links.stayzyapp.com
STAYZY_ALLOWED_HOSTS=localhost,127.0.0.1,stayzyapi-production.up.railway.app,links.stayzyapp.com
# Also configure APPLE_API_KEY_ID, APPLE_API_ISSUER_ID, APPLE_API_PRIVATE_KEY,
# and APPLE_ROOT_CERTIFICATE_PATHS (each prefixed STAYZY_).
# The iOS STAYZY_ENTITLEMENT_PUBLIC_KEY must match this service's JWT signing key.
# Sandbox Notifications V2: https://stayzyapi-production.up.railway.app/v1/webhooks/app-store
STAYZY_TRIAL_PRODUCT_ID=com.vistasolutions.stayzy.trial.seven_days
